{
  "manifest_version": 3,
  "name": "ProspAI - LinkedIn Actions",
  "version": "0.2.0",
  "description": "Execute les actions LinkedIn de ProspAI (invitations, messages) de facon humain-like.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
