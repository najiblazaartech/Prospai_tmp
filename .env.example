# === Core ===
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://prospai:prospai@db:5432/prospai
ENV=development
DEFAULT_PLAN=starter

# === Decouverte web (gratuit, sans cle) ===
# true : chaque recherche interroge le web en direct (vrai moteur du SaaS).
# false : repli hors-ligne (dataset curé transmission / pool de démo).
WEB_DISCOVERY=true

# === LLM (tier gratuit : https://console.mistral.ai/) ===
# Sans cle : le SaaS fonctionne avec le parsing heuristique + modeles de messages.
MISTRAL_API_KEY=

# === Providers B2B (optionnels, payants) ===
# Sans cle : mode MOCK avec donnees de demo.
APOLLO_API_KEY=
DROPCONTACT_API_KEY=

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
